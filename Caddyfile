# Replace bloginorium.me with your domain.
# Caddy automatically provisions and renews Let's Encrypt TLS certs.

# Disable the admin API (default localhost:2019). It is unauthenticated and
# would otherwise be reachable from the blog container via the shared pod
# loopback, letting a compromised blog reconfigure Caddy at runtime.
{
	admin off
	# Bound request handling: no default read/write timeout means a hung or
	# slow client holds a connection open indefinitely on this
	# memory/pid-constrained box.
	servers {
		timeouts {
			read_body 15s
			read_header 15s
			# write: Go's server WriteTimeout is an ABSOLUTE per-request deadline
			# (from request arrival), and counts queued time on a constrained
			# circuit. For Tor Browser (HTTP/2 over slow/high-latency circuits)
			# that can trip even on small pre-rendered pages. The slowloris
			# coverage we want comes from read_header; responses here are tiny
			# and buffered, so a write bound buys little. Disabled to avoid
			# harming legitimately slow (Tor) clients.
			# write 30s
		}
	}
}

bloginorium.me www.bloginorium.me {
	# The blog is strictly read-only: reject every method except GET and HEAD
	# at the edge, before reverse_proxy sees the request.
	@not-get-head {
		not method GET HEAD
	}
	header @not-get-head Allow "GET, HEAD"
	respond @not-get-head 405

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}

	request_body {
		max_size 1MB
	}

	reverse_proxy 127.0.0.1:3000 {
		health_uri /healthz
		health_interval 5s
	}
}
