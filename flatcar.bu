# Flatcar Container Linux Ignition config for the web pod.
#
# Convert to an Ignition JSON spec with Butane, then pass the result as the
# instance user-data when provisioning a Flatcar VPS:
#
#   butane --pretty -d . flatcar.bu -o ignition.json
#
# The blog image is NOT shipped here (Quadlet does not build images). CI builds
# and pushes it to ghcr.io/vinderull/web; the blog.container unit pulls it
# (Update=registry) on first boot — see the README "Flatcar / VPS" section.
variant: flatcar
version: 1.1.0
storage:
  directories:
    - path: /home/web
      mode: 0700
      user:
        name: web
      group:
        name: web
    - path: /var/lib/containers/storage-web
      mode: 0700
      user:
        name: web
      group:
        name: web
  files:
    # Podman is an opt-in Flatcar system extension (sysext), not in the base
    # image. Writing its name here makes Flatcar pull & merge flatcar-podman at
    # first boot (requires internet). See:
    # https://www.flatcar.org/docs/latest/provisioning/sysext/
    - path: /etc/flatcar/enabled-sysext.conf
      mode: 0444
      contents:
        inline: |
          podman
    # Image trust policy. The flatcar-podman sysext ships a strict
    # /etc/containers/policy.json (default: reject). Ship our own policy that
    # allowlists only the two registries the pod actually pulls from:
    # ghcr.io/vinderull (the blog image) and docker.io/library (caddy:2).
    # Everything else — including local docker-archive / oci-archive loads —
    # stays rejected by the default. Ignition writes /etc in the initramfs
    # before the sysext activates, so this wins over the sysext's default.
    - path: /etc/containers/policy.json
      mode: 0444
      contents:
        local: quadlet/policy.json
    - path: /etc/web/Caddyfile
      mode: 0444
      contents:
        local: Caddyfile
    - path: /etc/containers/systemd/users/2000/web.pod
      mode: 0444
      contents:
        local: quadlet/web.pod
    - path: /etc/containers/systemd/users/2000/blog.container
      mode: 0444
      contents:
        local: quadlet/blog.container
    - path: /etc/containers/systemd/users/2000/caddy.container
      mode: 0444
      contents:
        local: quadlet/caddy.container
    - path: /etc/containers/systemd/users/2000/caddy-data.volume
      mode: 0444
      contents:
        local: quadlet/caddy-data.volume
    - path: /etc/containers/systemd/users/2000/caddy-config.volume
      mode: 0444
      contents:
        local: quadlet/caddy-config.volume
    # Cosign public key for verifying the blog image signature (see
    # policy.json). Generated by `cosign generate-key-pair` on a dev machine;
    # the private key + password are GitHub Actions secrets (COSIGN_PRIVATE_KEY,
    # COSIGN_PASSWORD). Never commit cosign.key.
    - path: /etc/containers/cosign.pub
      mode: 0444
      contents:
        local: quadlet/cosign.pub
    # Enable cosign sigstore attachment lookups so policy.json's
    # sigstoreSigned rule can actually find the signatures cosign attaches
    # to the image. Without this, use-sigstore-attachments defaults to false
    # and podman pull rejects signed images ("no signature exists").
    - path: /etc/containers/registries.d/default.yaml
      mode: 0444
      contents:
        local: quadlet/registries.d.yaml
    # Hardened sshd_config (public-key-only, no root login, hardened
    # ciphers/MACs/KEX). Ignition writes this before sshd starts on first boot.
    - path: /etc/ssh/sshd_config
      mode: 0444
      overwrite: true
      contents:
        local: sshd_config
    # drop in to disable USB since we aren't ever going to use it
    - path: /etc/modprobe.d/blacklist.conf
      mode: 0444
      contents:
        inline: |
          blacklist usb-storage
    # kernel hardening: restrict info leaks and unprivileged kernel interfaces
    - path: /etc/sysctl.d/99-hardening.conf
      mode: 0444
      contents:
        inline: |
            kernel.kptr_restrict = 2
            kernel.dmesg_restrict = 1
            kernel.unprivileged_bpf_disabled = 1
            net.core.bpf_jit_harden = 2
            kernel.yama.ptrace_scope = 1
            net.ipv4.conf.all.rp_filter = 1
            net.ipv4.conf.default.rp_filter = 1
            net.ipv4.conf.all.accept_redirects = 0
            net.ipv4.conf.default.accept_redirects = 0
            net.ipv4.conf.all.secure_redirects = 0
            net.ipv4.conf.default.secure_redirects = 0
            net.ipv4.conf.all.accept_source_route = 0
            net.ipv4.conf.default.accept_source_route = 0
            net.ipv4.conf.all.send_redirects = 0
            net.ipv4.conf.default.send_redirects = 0
            net.ipv4.ip_forward = 0
            net.ipv6.conf.all.accept_redirects = 0
            net.ipv6.conf.default.accept_redirects = 0
            net.ipv6.conf.all.accept_source_route = 0
            net.ipv6.conf.default.accept_source_route = 0
            fs.protected_hardlinks = 1
            fs.protected_symlinks = 1
            fs.protected_regular = 2
            fs.protected_fifos = 1
            net.ipv4.tcp_syncookies = 1
            fs.suid_dumpable = 0
            # Rootless podman requires user namespaces — one per container plus one for
            # the pod infra, plus headroom for setup/exec.
            # Overrides the rootful default of 0 in this same file.
            user.max_user_namespaces = 100
            kernel.perf_event_paranoid = 3
            kernel.sysrq = 0
    # Persist the unprivileged port floor: allows the unprivileged web user to
    # bind 80/443 without CAP_NET_BIND_SERVICE.
    - path: /etc/sysctl.d/60-rootless-ports.conf
      mode: 0444
      contents:
        inline: |
          net.ipv4.ip_unprivileged_port_start = 80
    - path: /etc/containers/storage.conf
      mode: 0444
      contents:
        inline: |
          [storage]
          driver = "overlay"
          rootless_storage_path = "/var/lib/containers/storage-web"
    # Store journal only in memory (tmpfs), not on disk. Deliberately
    # ephemeral: no remote log sink, and the journal (incl. sshd audit
    # trail) is disposable across reboots. That tradeoff is accepted.
    - path: /etc/systemd/journald.conf.d/10-volatile-storage.conf
      mode: 0444
      contents:
        inline: |
          [Journal]
          Storage=volatile
          RuntimeMaxUse=16M
          RuntimeMaxFileSize=4M
    # disabe core user sudo access
    #- path: /etc/sudoers.d/core-passwd
    #  mode: 0444
    #  contents:
    #    inline: |
    #      core	ALL=(ALL) 	ALL

systemd:
  units:
    # SSH daemon via socket activation (Flatcar default). A dropin on
    # sshd.socket overrides the port to match sshd_config; sshd spins up
    # on-demand per connection.
    - name: sshd.socket
      dropins:
        - name: 10-port.conf
          contents: |
            [Socket]
            ListenStream=
            ListenStream=49989
    # Enable linger for the web user so its systemd --user session starts at
    # boot without requiring a login.
    - name: enable-linger-web.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable linger for web
        After=systemd-user-sessions.service
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/loginctl enable-linger web
        [Install]
        WantedBy=multi-user.target
    # Keep quadlet containers up to date: podman-auto-update.timer (ships with
    # the flatcar-podman sysext) runs `podman auto-update` on a schedule.
    # `Update=registry` in blog.container makes it pull the latest image, then
    # systemd restarts the generated quadlet units. Enabling it here means no
    # manual `sudo systemctl enable --now podman-auto-update.timer` on the box.
    - name: podman-auto-update.timer
      enabled: true
    # Preemptive OOM handling on a 512MB box: kernel OOM kills semi-randomly
    # (often sshd, locking us out). oomd uses cgroup-v2 pressure to reap the
    # biggest memory user (the pod) first instead.
    - name: systemd-oomd.service
      enabled: true
    # Restrict docker to just root
    - name: docker.socket
      dropins:
        - name: 10-restrict.conf
          contents: |
            [Socket]
            SocketGroup=root

passwd:
  users:
    - name: web
      uid: 2000
      primary_group: web
      groups:
        - systemd-journal
      # No SSH keys — the web account is the runtime daemon, not an interactive
      # operator. SSH is restricted to the core admin account (see sshd_config).
      # Ignition's useradd auto-allocates subuid/subgid ranges in /etc/sub{u,g}id.
    - name: core
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHzOTEaaLIk/vVAEGpfGZX1iuKGXiDhflxQsdBpKzyWC [EMAIL]
  groups:
    - name: web
      gid: 2000
