[Unit]
Description=Blog
# Pod= auto-generates Requires=/After= on web-pod.service.
Before=caddy.service

[Container]
Image=ghcr.io/vinderull/web:latest
ContainerName=blog
Pod=web.pod
AutoUpdate=registry
Pull=newer
# Image pulled unauthenticated from the public GHCR package; no auth file.
# Reachable inside the pod at 127.0.0.1:3000; no host publish needed.
User=65532:65532
ReadOnly=true
ReadOnlyTmpfs=false
DropCapability=all
NoNewPrivileges=true
# ponytail: static binary never forks/climbs; tighten further on a single-app host.
PodmanArgs=--memory=128m --cpus=1 --pids-limit=20 --ulimit nofile=256:256
# Health check curls /healthz in the pod namespace. Notify=healthy delays
# systemd's "active" notification until the health check passes, so Caddy
# (After=blog.service) won't start until blog is actually serving.
HealthCmd=curl -fsS http://127.0.0.1:3000/healthz || exit 1
HealthInterval=5s
HealthStartPeriod=60s
HealthTimeout=3s
HealthRetries=2
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
