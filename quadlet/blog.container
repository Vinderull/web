[Unit]
Description=Blog
# Pod= auto-generates Requires=/After= on web-pod.service.
Before=caddy.service

[Container]
Image=ghcr.io/vinderull/web:latest
ContainerName=blog
Pod=web.pod
AutoUpdate=registry
Pull=newer
# Image pulled unauthenticated from the public GHCR package; no auth file.
# Reachable inside the pod at 127.0.0.1:3000; no host publish needed.
User=65532:65532
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
# ponytail: static binary never forks/climbs; tighten further on a single-app host.
PodmanArgs=--memory=256m --cpus=1 --pids-limit=100 --ulimit nofile=1024:1024

[Service]
# Compose `restart: unless-stopped` ≈ systemd Restart=always
# (a deliberate `systemctl stop` is still respected).
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
