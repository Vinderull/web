[Unit]
Description=Blog
# Pod= auto-generates Requires=/After= on web-pod.service.
Before=caddy.service

[Container]
Image=ghcr.io/vinderull/web:latest
ContainerName=blog
Pod=web.pod
AutoUpdate=registry
Pull=newer
# Image pulled unauthenticated from the public GHCR package; no auth file.
# Reachable inside the pod at 127.0.0.1:3000; no host publish needed.
User=65532:65532
ReadOnly=true
# ReadOnlyTmpfs=false: do NOT mount the writable tmpfs that ReadOnly would
# otherwise add on /tmp, /run, /var/tmp, /dev, /dev/shm (default is true).
# The image is static musl and keeps all data in memory — no scratch needed —
# so the container is totally read-only.
ReadOnlyTmpfs=false
#DropCapability=all
NoNewPrivileges=true
# note: static binary never forks/climbs; tighten further on a single-app host.
PodmanArgs=--memory=128m --cpus=1 --pids-limit=20 --ulimit nofile=256:256
# No systemd HealthCmd: the scratch image has no curl and no /bin/sh (podman
# runs string health checks via CMD-SHELL), so one always fails; Notify=healthy
# would wedge the service and keep Caddy (After=blog.service) from starting.
# Caddy self-gates on /healthz (Caddyfile health_uri). Don't re-add HealthCmd.

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
