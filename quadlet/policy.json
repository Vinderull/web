{
  "default": [
    { "type": "reject" }
  ],
  "transports": {
    "docker": {
      "ghcr.io/vinderull": [
        {
          "type": "sigstoreSigned",
          "fulcio": "https://fulcio.sigstore.dev",
          "rekorURL": "https://rekor.sigstore.dev",
          "fulcioIdentity": {
            "issuer": "https://token.actions.githubusercontent.com",
            "subjectRegExp": "^https://github.com/vinderull/web/.github/workflows/ci.yml@refs/tags/v[0-9]+(\\.[0-9]+)*$"
          }
        }
      ],
      "docker.io/library": [{ "type": "insecureAcceptAnything" }]
    }
  }
}
