{
  "default": [
    { "type": "reject" }
  ],
  "transports": {
    "docker": {
      "ghcr.io/vinderull": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/etc/containers/cosign.pub",
          "signedIdentity": { "type": "matchRepository" }
        }
      ],
      "docker.io/library/caddy": [{ "type": "insecureAcceptAnything" }]
    }
  }
}
